Bootstrap: docker

# The base image carries the torch version that `genetic/requirements.txt`
# pins, on Python 3.10. CUDA 12.1 supports the L40S (sm_89) and H100 (sm_90).
From: pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

%files
    genetic/requirements.txt /opt/requirements.txt

%post
    pip install --no-cache-dir -r /opt/requirements.txt

    # The build fails here when a pinned package does not import.
    python -c "import matplotlib, numpy, pandas, sklearn, torch, tqdm; print('torch', torch.__version__, '| numpy', numpy.__version__)"

%environment
    export LC_ALL=C
